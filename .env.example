# Copie este arquivo para .env e ajuste os valores antes de rodar `docker compose up`.
# Nunca versione o arquivo .env real.

POSTGRES_DB=whatscrm
POSTGRES_USER=whatscrm
POSTGRES_PASSWORD=troque-esta-senha

# Gere um valor aleatório forte (ex.: openssl rand -base64 48) — nunca reutilize este exemplo em produção.
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-forte-com-32-ou-mais-caracteres
JWT_ISSUER=WhatsCrm.Api
JWT_AUDIENCE=WhatsCrm.Client

# Origem do frontend liberada no CORS da API (ajuste se publicar em outro domínio/porta).
FRONTEND_ORIGIN=http://localhost:8080

# Porta local exposta pelo Nginx (http://localhost:HTTP_PORT).
HTTP_PORT=8080

ASPNETCORE_ENVIRONMENT=Production
